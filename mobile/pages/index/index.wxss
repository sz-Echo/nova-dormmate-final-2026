/* M4 S1/S3：WXSS 页面样式（任务书第 17 条，对应 M1 自定义样式，现场能指出位置）：
   ① 卡片式三区块：.card 白底圆角阴影
   ② 状态大字高亮 .status + 建议灰字 .advice
   ③ 错误红色提示 .error、历史虚线分隔 .history-item、空历史"暂无记录"占位 */
.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 32rpx;
}

/* 小程序 button 默认带边框，先重置再自定样式 */
button::after {
  border: none;
}

.buttons {
  display: flex;
  margin-top: 8rpx;
}

.btn {
  flex: 1;
  font-size: 30rpx;
  background: #eef2f7;
  color: #333;
}

.btn + .btn {
  margin-left: 16rpx;
}

.btn.primary {
  background: #4a90d9;
  color: #fff;
}

.error {
  color: #d0021b;
  font-size: 28rpx;
  margin-top: 16rpx;
}

.section-title {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.status {
  font-size: 64rpx;
  font-weight: bold;
}

.advice {
  font-size: 30rpx;
  color: #888;
  margin-top: 8rpx;
}

.empty {
  color: #aaa;
  font-size: 28rpx;
}

.history-item {
  font-size: 28rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx dashed #eee;
}

.history-item:last-child {
  border-bottom: none;
}
