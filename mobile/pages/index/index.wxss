/* M4 S1/S3：WXSS 页面样式（任务书第 17 条，对应 M1 自定义样式，现场能指出位置）：
   ① 卡片式三区块：.card 白底圆角阴影
   ② 状态大字高亮 .status + 建议灰字 .advice
   ③ 错误红色提示 .error、历史虚线分隔 .history-item、空历史"暂无记录"占位 */
.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 32rpx;
}

/* 小程序 button 默认带边框，先重置再自定样式 */
button::after {
  border: none;
}

.buttons {
  display: flex;
  margin-top: 8rpx;
}

.btn {
  flex: 1;
  font-size: 30rpx;
  background: #eef2f7;
  color: #333;
}

.btn + .btn {
  margin-left: 16rpx;
}

.btn.primary {
  background: #4a90d9;
  color: #fff;
}

.error {
  color: #d0021b;
  font-size: 28rpx;
  margin-top: 16rpx;
}

.section-title {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 16rpx;
}

/* A1：MQTT 连接状态行（连接中/已连接/断开重连等状态文本） */
.mqtt-state {
  font-size: 30rpx;
  color: #4a90d9;
  margin-bottom: 8rpx;
}

/* A2：三节点卡片（状态着色与 dashboard 一致）+ 开启风扇按钮 */
.node-card {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.node-card:last-child {
  margin-bottom: 0;
}

.node-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.node-name {
  font-size: 32rpx;
  font-weight: bold;
}

.node-status {
  font-size: 28rpx;
}

.node-status.normal { color: #27ae60; }
.node-status.cold { color: #4a90d9; }
.node-status.hot { color: #e67e22; }
.node-status.wet { color: #16a085; }
.node-status.waiting { color: #aaa; }

/* A3：★当前重点 + 事件状态徽标（与 Dashboard 事件/优先通道同源） */
.node-right {
  display: flex;
  align-items: center;
}

.node-star {
  color: #d0021b;
  font-size: 24rpx;
  margin-left: 8rpx;
}

.node-badge {
  font-size: 24rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

.node-badge.open { background: #fdf3e7; color: #e67e22; }
.node-badge.handling { background: #eaf3fd; color: #4a90d9; }
.node-badge.recovered { background: #e8f8ef; color: #27ae60; }
.node-badge.cancelled { background: #f0f0f0; color: #888; }

.node-meta {
  font-size: 26rpx;
  color: #666;
  margin: 8rpx 0;
}

.fan-btn {
  margin-top: 8rpx;
  font-size: 28rpx;
}

button[disabled].fan-btn {
  background: #eef2f7;
  color: #aaa;
}

/* A2：离线降级模式说明（不影响上方实时卡片） */
.note {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.status {
  font-size: 64rpx;
  font-weight: bold;
}

.advice {
  font-size: 30rpx;
  color: #888;
  margin-top: 8rpx;
}

.empty {
  color: #aaa;
  font-size: 28rpx;
}

.history-item {
  font-size: 28rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx dashed #eee;
}

.history-item:last-child {
  border-bottom: none;
}
